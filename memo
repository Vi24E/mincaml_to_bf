let rec fib n k =
  if n <= 1 then k n
  else let rec f x =
	let rec g y = k (x + y) in
	fib (n - 2) g
  in
  fib (n - 1) f
in fib 10 (fun x -> print_int x)
```

```ocaml
let rec g k x y = 
  k (x + y)
in
let rec f k n x =
  fib (n - 2) (g k x)
in
let rec fib n k =
  if n <= 1 then k n 
  else fib (n - 1) (f k n)
in fib 10 (fun x -> print_int x)
